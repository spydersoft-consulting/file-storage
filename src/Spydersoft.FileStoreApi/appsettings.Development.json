{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "System": "Information"
      }
    }
  },
  "Telemetry": {
    "Trace": { "Type": "console" },
    "Metrics": { "Type": "console" },
    "Log": { "Type": "console" }
  }
}
